{
  "manifest_version": 2,
  "id": "github.cateye.api-balance",
  "version": "1.0.0",
  "name": "API余额查询",
  "description": "查询指定 API Key 的账户余额：通过配置的余额接口获取 JSON 数据，并使用 LLM 总结为清晰的中文报告；提供 /wallet 指令与 get_api_balance 工具。",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateyemizuki"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_api_balance",
    "homepage": "https://github.com/cateyemizuki/cateye_api_balance",
    "documentation": "https://github.com/cateyemizuki/cateye_api_balance/blob/main/README.md",
    "issues": "https://github.com/cateyemizuki/cateye_api_balance/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.25.0"
    }
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "local",
      "value": "logo.png",
      "fallback": "wallet"
    }
  },
  "capabilities": [
    "send.text",
    "send.forward"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
